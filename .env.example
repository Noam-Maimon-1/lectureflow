# ── Lecture Pipeline Configuration ───────────────────────────────
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# All settings are optional except ANTHROPIC_API_KEY
# (unless you use --skip-analysis).

# Required for the analysis stage. Get one at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Whisper model size: tiny | base | small | medium | large
# Use "medium" or "large" for non-English lectures.
LP_WHISPER_MODEL=base

# Where to save output files
# LP_OUTPUT_DIR=~/lecture_pipeline_output

# Path to custom instructions for Claude
# LP_INSTRUCTIONS_FILE=./instructions/my_custom_prompt.txt

# Keep the video file after extracting audio (true/false)
# LP_KEEP_VIDEO=false

# Download retry count and timeout (seconds)
# LP_DOWNLOAD_RETRIES=3
# LP_DOWNLOAD_TIMEOUT=300

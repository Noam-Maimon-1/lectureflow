# ── Lecture Pipeline Configuration ───────────────────────────────
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# All settings are optional except ANTHROPIC_API_KEY
# (unless you use --skip-analysis).

# Required for the analysis stage. Get one at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Transcription ──
# Which backend turns audio into text:
#   local — OpenAI Whisper on this machine (free, works offline, slow on CPU)
#   groq  — Groq's hosted Whisper API (fast, runs whisper-large-v3; needs GROQ_API_KEY)
# Can be overridden per run with --transcriber local|groq
LP_TRANSCRIBER_BACKEND=local

# Local backend: Whisper model size: tiny | base | small | medium | large
# Use "medium" or "large" for non-English lectures.
LP_WHISPER_MODEL=base

# Groq backend: API key (secret — keep it in .env only). Get one at:
# https://console.groq.com/keys
GROQ_API_KEY=

# Groq backend: model. whisper-large-v3 (most accurate) or whisper-large-v3-turbo (faster, cheaper)
# LP_GROQ_MODEL=whisper-large-v3

# Claude model, output budget and effort for the analysis stage.
# max_tokens covers Claude's thinking plus the JSON study guide.
# Effort: low | medium | high | xhigh | max (higher = more thinking, slower, costs more)
# LP_CLAUDE_MODEL=claude-sonnet-5-5
# LP_CLAUDE_MAX_TOKENS=64000
# LP_CLAUDE_EFFORT=low

# Where to save output files
# LP_OUTPUT_DIR=~/lecture_pipeline_output

# Path to custom instructions for Claude
# LP_INSTRUCTIONS_FILE=./instructions/my_custom_prompt.txt

# Skip the HTML study guide (true/false)
# LP_SKIP_HTML=false
